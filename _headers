# Sicherheits-Kopfzeilen. Angelegt 2026-09-05, fuer Sandras Check am 2026-10-25
# angepasst: keine Fremdquelle mehr. Kein Einwilligungs-Banner noetig (kein
# Cookie, kein fremdes Skript), kein eingebettetes Video. Die Eintragung laeuft
# ueber die eigene Netlify-Funktion, die mit Wix spricht (connect-src 'self').
# Inline-Style und inline-Skript sind erlaubt, weil CSS und JS in index.html stehen.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=()
  Cross-Origin-Opener-Policy: same-origin

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/assets/*
  Cache-Control: public, max-age=2592000
